CREATE OR REPLACE FUNCTION get_event_report(p_event_id UUID)
RETURNS TEXT
LANGUAGE plpgsql
AS $$
DECLARE
    -- 1. CURSOR TANIMI: Olayın katılımcılarını ve durumlarını seçer
    cur_attendees CURSOR FOR 
        SELECT u.username, a.has_completed
        FROM attendances a
        JOIN users u ON a.user_id = u.user_id
        WHERE a.event_id = p_event_id;

    -- 2. RECORD TANIMI: Her döngüde satır verisini tutacak değişken
    rec_attendee RECORD;

    -- Sonuç metnimiz
    v_output TEXT := '';
BEGIN
    -- Cursor'ı aç
    OPEN cur_attendees;

    -- Satır satır gezme döngüsü
    LOOP
        FETCH cur_attendees INTO rec_attendee;
        EXIT WHEN NOT FOUND; -- Satır bitince çık

        -- Metni birleştir (Örn: "Ahmet: Tamamladı | Mehmet: Tamamlamadı | ")
        v_output := v_output || rec_attendee.username || ': ' || 
                    CASE WHEN rec_attendee.has_completed THEN 'Tamamladı' ELSE 'Sürüyor' END || ' | ';
    END LOOP;

    -- Cursor'ı kapat
    CLOSE cur_attendees;

    -- Sonuç boşsa bilgi ver, doluysa döndür
    IF v_output = '' THEN
        RETURN 'Henüz katılımcı yok.';
    ELSE
        RETURN v_output;
    END IF;
END;
$$;